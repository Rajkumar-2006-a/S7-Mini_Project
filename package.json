{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node dev.mjs",
    "dev:client": "node node_modules/vite/bin/vite.js --config client/vite.config.ts client",
    "dev:server": "node node_modules/tsx/dist/cli.mjs watch server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "node node_modules/vite/bin/vite.js build --config client/vite.config.ts client",
    "build:server": "node node_modules/esbuild/bin/esbuild server/index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=server/dist/server.cjs",
    "start": "node server/dist/server.cjs",
    "preview": "node node_modules/vite/bin/vite.js preview --config client/vite.config.ts client",
    "clean": "node -e \"for (const path of ['client/dist', 'server/dist']) require('node:fs').rmSync(path, { recursive: true, force: true })\"",
    "lint": "node node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "mongodb": "^7.6.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  }
}
