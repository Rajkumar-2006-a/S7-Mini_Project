{
  "name": "medtrack-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node dist/server.cjs",
    "dev": "tsx watch index.ts",
    "build": "esbuild index.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs && esbuild app.ts --bundle --platform=node --target=node18 --format=esm --packages=external --outfile=api/app.bundle.js",
    "build:vercel": "esbuild app.ts --bundle --platform=node --target=node18 --format=esm --packages=external --outfile=api/app.bundle.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "mongodb": "^7.6.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
